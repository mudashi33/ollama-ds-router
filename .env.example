# 复制成 .env 后填值；start.cmd 会用 node --env-file=.env 加载
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
OLLAMA_API_KEY=xxxxxxxxxxxxxxxx

# 可选
# ROUTER_PORT=8788
# DEEPSEEK_MODEL=deepseek-flash
# OLLAMA_MODEL=deepseek-v4.1-flash
# ROUTER_FIRST_BYTE_TIMEOUT_MS=180000

# max_tokens 护栏（详见 README「行为细节」）：长对话里被 DSH 钳成 1 的输出预算会抬到这个值，0 = 关闭
# ROUTER_GUARD_MAX_TOKENS=8192
# 只对消息数 >= 此值的请求生效，保护探活 / 短对话
# ROUTER_GUARD_MIN_MSGS=20
