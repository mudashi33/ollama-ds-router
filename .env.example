# 复制成 .env 后填值；start.cmd / supervisor 会用 node --env-file=.env 加载
# 这个文件里列出的就是代码真正会读的全部变量（router 27 个 + 守护 9 个，去重后 34 个），
# 没列出来的都不生效。

# ---------------------------------------------------------------- 必填
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
OLLAMA_API_KEY=xxxxxxxxxxxxxxxx

# ---------------------------------------------------------------- 上游
# 换网关/自建代理时改这两个 base（末尾斜杠会自动去掉）
# DEEPSEEK_BASE=https://api.deepseek.com
# OLLAMA_BASE=https://ollama.com/v1
# 上游真实模型名；请求体里的 model 会被映射成这里的值
# DEEPSEEK_MODEL=deepseek-flash
# OLLAMA_MODEL=deepseek-v4.1-flash

# ---------------------------------------------------------------- 监听
# 只给本机 DSH 用就别改成 0.0.0.0（改了等于把带 key 的代理暴露到局域网）
# ROUTER_HOST=127.0.0.1
# ROUTER_PORT=8788

# ---------------------------------------------------------------- 超时
# 首字节超时：上游这么久还不吐第一个字就放弃并换一家（默认 60 秒）
# ROUTER_FIRST_BYTE_TIMEOUT_MS=60000
# 流中途的静默超时：已经开吐了，但连续这么久没有新数据就掐断（默认 120 秒）
# ROUTER_IDLE_TIMEOUT_MS=120000
# 读上游错误正文（4xx/5xx 的 JSON）的上限：上游回了头却把正文挂住时的兜底（默认 15 秒）
# ROUTER_ERROR_BODY_TIMEOUT_MS=15000

# ---------------------------------------------------------------- 看板上的余额卡片
# 余额只是两张卡片，不值得让整页等它：默认 3 秒拿不到就显示「取不到」
# ROUTER_BALANCE_TIMEOUT_MS=3000
# 余额成功后的缓存时间（毫秒），0 = 每次都真去查
# ROUTER_BALANCE_TTL_MS=60000

# ---------------------------------------------------------------- 账本 / 日志 / 模式
# 都是路径；默认落在仓库目录里
# ROUTER_STATS_FILE=stats.json
# ROUTER_LOG_FILE=router.log
# ROUTER_MODE_FILE=mode.json
# ROUTER_HOLIDAYS_FILE=holidays.json
# 账本保留多少天（每天一个桶，只增不减）
# ROUTER_STATS_KEEP_DAYS=365
# /_router/recent 里留多少条内存记录（默认 20，只放内存、重启清空）
# ROUTER_RECENT_MAX=20

# ---------------------------------------------------------------- 计费
# 美元 → 人民币汇率，只影响看板上的「省了多少」估算
# ROUTER_FX_USD_CNY=7.1

# ---------------------------------------------------------------- max_tokens 护栏
# 详见 README「行为细节」：长对话里被 DSH 钳成 1 的输出预算会抬到这个值，0 = 关闭
# 默认 128000（128k，与 DSH 侧 models[].maxTokens 保持一致）。别设太小：实测被抬到
# 8192 时仍有 3% 的请求正好写满 8192，客户端又会显示「已达到输出 token 上限」。
# ROUTER_GUARD_MAX_TOKENS=128000
# 只对消息数 >= 此值的请求生效，保护探活 / 短对话
# ROUTER_GUARD_MIN_MSGS=20

# ---------------------------------------------------------------- 上游熔断
# 连续几次「上游不健康」（5xx / 429 / 超时 / 连不上）就暂停用这家，0 = 关闭熔断
# 400 / 404 / 422 这类参数错误不算，上下文溢出和客户端主动取消也不算
# ROUTER_BREAKER_FAILS=3
# 熔断后每隔多久发一条 1-token 的探针试试活（默认 180000 = 3 分钟）
# 探针成功就自动切回这家；额度类错误（402 / 429 带「额度用尽」文案）一次即熔断
# ROUTER_BREAKER_PROBE_MS=180000
# 探针本身的超时（默认 20 秒）
# ROUTER_BREAKER_PROBE_TIMEOUT_MS=20000
# 多久扫一次有没有到点的探针（默认 15 秒；不用等于探针间隔）
# ROUTER_BREAKER_TICK_MS=15000

# ---------------------------------------------------------------- 调试
# 把时钟往前/后拨（毫秒），用来验证「到点自动切换」而不用改系统时间
# ROUTER_CLOCK_OFFSET_MS=0

# ================================================================ supervisor（tools/supervisor.mjs 读）
# 守护进程自己的日志，和 router.log 不是一回事
# ROUTER_SUPERVISOR_LOG=autostart/router-supervisor.log
# 超过这个大小就轮转一次（copytruncate，备份成 .1）
# ROUTER_LOG_MAX_BYTES=5242880
# 最长保留天数：超过就轮转（低频运行时只靠大小永远轮不到）；0 = 只看大小
# ROUTER_LOG_MAX_AGE_DAYS=7
# 健康检查间隔 / 重启等待
# ROUTER_SUPERVISOR_CHECK_MS=30000
# ROUTER_SUPERVISOR_RESTART_MS=5000
# 单实例互斥用的控制端口
# ROUTER_SUPERVISOR_PORT=8790
# 指定 node 可执行文件（默认用跑守护的那个）
# NODE_EXE=D:\nodejs\node.exe
